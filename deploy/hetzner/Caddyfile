# ProjeXtPal op Hetzner. Caddy termineert TLS zelf en haalt de certificaten
# bij Let's Encrypt, inclusief verlenging. Dat vervangt de nginx + Cloudflare
# tunnel van de Mac Studio.
#
# Op de Studio stond hier een `map`-blok dat X-Forwarded-Proto naar https
# forceerde, omdat cloudflared die header niet betrouwbaar doorgaf en Django's
# SECURE_SSL_REDIRECT daardoor eindeloos bleef redirecten. Dat blok is hier
# niet nodig: Caddy zet X-Forwarded-Proto zelf correct, omdat het de TLS-
# verbinding zelf afhandelt.
#
# De routes hieronder komen één op één uit
# /Users/sami/deploys/projextpal-runtime/nginx/conf.d/default.conf.

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	# AI-visuals duren tot enkele minuten. Deze route moet vóór /api/ staan,
	# anders vangt die de aanvraag af met de standaard timeout.
	handle /api/v1/academy/visuals/* {
		reverse_proxy backend:8001 {
			transport http {
				dial_timeout 300s
				response_header_timeout 300s
				read_timeout 300s
			}
		}
	}

	# CORS komt van Django's corsheaders. Hier geen CORS-headers toevoegen,
	# dubbele headers breken de browser.
	handle /api/* {
		reverse_proxy backend:8001
	}

	# Django's eigen admin staat op /django-admin/ zodat de React-adminportaal
	# /admin/* houdt. Zonder deze scheiding gaf een refresh op /admin/... een
	# Django-404 in plaats van de SPA.
	handle /django-admin/* {
		reverse_proxy backend:8001
	}

	handle_path /static/* {
		root * /app/staticfiles
		file_server
	}

	handle_path /media/* {
		root * /app/media
		file_server
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Schone API-host. Alles naar de backend, op de statische bestanden na.
api.{$SITE_DOMAIN} {
	encode zstd gzip

	handle /api/v1/academy/visuals/* {
		reverse_proxy backend:8001 {
			transport http {
				dial_timeout 300s
				response_header_timeout 300s
				read_timeout 300s
			}
		}
	}

	handle_path /static/* {
		root * /app/staticfiles
		file_server
	}

	handle_path /media/* {
		root * /app/media
		file_server
	}

	handle {
		reverse_proxy backend:8001
	}
}
