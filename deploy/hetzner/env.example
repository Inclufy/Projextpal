# Sleutels voor één omgeving. Er is er één per omgeving, naast
# docker-compose.stack.yml op de doelmachine:
#
#   .env.production   Hetzner
#   .env.staging      Hetzner
#   .env.test         Mac Studio
#
# Dit bestand bevat geen waarden, alleen de sleutels. Kopieer het naar de
# doelmachine en vul het daar in. Zet het nooit in git.
#
#   cp deploy/hetzner/env.example .env.staging && chmod 600 .env.staging
#
# De lijst komt uit de draaiende productie op de Mac Studio
# (/Users/sami/deploys/projextpal-runtime/backend.env). Drie soorten sleutels
# zijn daar bewust weggelaten:
#
#   PATH, GPG_KEY, LANG, PYTHON_VERSION, PYTHON_SHA256
#     Die komen uit het image zelf en horen niet in een env-bestand. PATH is de
#     gevaarlijkste: die overschrijft het pad ín de container, dus zodra het
#     image een ander pad krijgt, breekt de container zonder duidelijke fout.
#
#   POSTGRES_HOST, POSTGRES_PORT, REDIS_URL
#     Die zet de compose zelf, wijzend naar de servicenamen op het interne
#     netwerk. Ze hier nog eens zetten levert alleen een tweede waarheid op.

# ── Adres ───────────────────────────────────────────────────────────────────
# Op Hetzner de domeinnamen; Caddy haalt en verlengt de certificaten dan zelf.
#   productie   SITE_ADDRESS=projextpal.com, www.projextpal.com
#               API_ADDRESS=api.projextpal.com
#   staging     SITE_ADDRESS=staging.projextpal.com
#               API_ADDRESS=api.staging.projextpal.com
#
# Op de Studio staat de Cloudflare-tunnel ervoor en doet die de TLS. Gebruik dan
# een adres zonder domeinnaam, dan zet Caddy uit zichzelf geen certificaten aan:
#   test        SITE_ADDRESS=:80
#               API_ADDRESS=:8081      (niet gepubliceerd, dus onbereikbaar)
#               HOST_PORT=8110         (waar de tunnel naartoe stuurt)
SITE_ADDRESS=
API_ADDRESS=
# Alleen nodig op de Studio, waar de proxy op een lokale poort staat.
HOST_PORT=

# Moet een waarde hebben, ook waar Caddy geen certificaten aanvraagt: leeg maakt
# van de regel `email` in de Caddyfile een regel zonder argument, en dan weigert
# Caddy te starten. Op test en staging verder ongebruikt.
ACME_EMAIL=

# ── Zoekmachines ────────────────────────────────────────────────────────────
# Alleen productie hoort gevonden te worden. Staat dit op noindex, dan stuurt
# Caddy bij elk antwoord `X-Robots-Tag: noindex, nofollow` mee.
#   productie        ROBOTS_TAG=all
#   staging en test  ROBOTS_TAG=noindex, nofollow
# Dat houdt zoekmachines weg, geen mensen: wie het adres kent komt er nog steeds,
# dus de inlog van de applicatie blijft de echte afscherming.
ROBOTS_TAG=noindex, nofollow

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Django leest dit; host moet `postgres` zijn, de servicenaam in de compose.
DATABASE_URL=

# ── Redis ───────────────────────────────────────────────────────────────────
# Op de Studio stond dit wachtwoord letterlijk in het startcommando en was het
# dus zichtbaar in `docker ps`. Kies hier een nieuwe waarde.
REDIS_PASSWORD=

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
# Moet `localhost` bevatten, anders geeft de healthcheck van de backend een
# 400 en blijft de container als "unhealthy" staan terwijl hij prima werkt.
ALLOWED_HOSTS=
BASE_URL=
FRONTEND_URL=
FIELD_ENCRYPTION_KEY=

# ── https-gedrag ────────────────────────────────────────────────────────────
# Caddy termineert TLS en zet X-Forwarded-Proto goed, dus deze mogen aan.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=

# ── E-mail ──────────────────────────────────────────────────────────────────
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Betalingen ──────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Let op: de webhook-URL bij Stripe wijst nu naar de Studio. Die moet na de
# verhuizing naar het nieuwe domein, anders komen betalingsmeldingen niet aan.
STRIPE_WEBHOOK_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Foutrapportage ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Deze wordt in de frontend-build gebakken, niet op de server gelezen. Hij moet
# als CI-variabele in GitLab staan, zie deploy/hetzner/README.md.
VITE_SENTRY_DSN=

# ── Geheugenlimieten ────────────────────────────────────────────────────────
# Alleen invullen als je hiervan af wilt wijken. De standaardwaarden staan in
# docker-compose.stack.yml en zijn gebaseerd op het gemeten verbruik van de
# productie op de Mac Studio op 30 augustus 2026:
#
#   backend 952 MB → limiet 2g      postgres 30 MB → limiet 1g
#   frontend 63 MB → limiet 256m    redis    39 MB → limiet 512m
#   proxy    20 MB → limiet 256m
#
# Ze zijn er zodat één omgeving de machine niet kan opeten. Dat telt zodra
# staging en productie op dezelfde machine staan.
# MEM_BACKEND=
# MEM_POSTGRES=
# MEM_REDIS=
# MEM_FRONTEND=
# MEM_PROXY=
