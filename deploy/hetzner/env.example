# ProjeXtPal op Hetzner: .env naast docker-compose.hetzner.yml.
#
# Dit bestand bevat geen waarden, alleen de sleutels die de stack nodig heeft.
# Kopieer het naar .env op de server en vul het daar in. Zet het nooit in git.
#
#   cp deploy/hetzner/env.example .env && chmod 600 .env
#
# De lijst komt uit de draaiende productie op de Mac Studio
# (/Users/sami/deploys/projextpal-runtime/backend.env). Drie soorten sleutels
# zijn daar bewust weggelaten:
#
#   PATH, GPG_KEY, LANG, PYTHON_VERSION, PYTHON_SHA256
#     Die komen uit het image zelf en horen niet in een env-bestand. PATH is de
#     gevaarlijkste: die overschrijft het pad ín de container, dus zodra het
#     image een ander pad krijgt, breekt de container zonder duidelijke fout.
#
#   POSTGRES_HOST, POSTGRES_PORT, REDIS_URL
#     Die zet de compose zelf, wijzend naar de servicenamen op het interne
#     netwerk. Ze hier nog eens zetten levert alleen een tweede waarheid op.

# ── Domein en certificaten ──────────────────────────────────────────────────
# SITE_DOMAIN zonder www en zonder https. Caddy bedient dit domein, www ervoor,
# en api.<domein>. Alle drie moeten in DNS naar het IP van de server wijzen,
# en in Cloudflare op "DNS only" staan tot Caddy zijn certificaat heeft.
SITE_DOMAIN=
# Adres waar Let's Encrypt over verlopende certificaten mailt.
ACME_EMAIL=

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Django leest dit; host moet `postgres` zijn, de servicenaam in de compose.
DATABASE_URL=

# ── Redis ───────────────────────────────────────────────────────────────────
# Op de Studio stond dit wachtwoord letterlijk in het startcommando en was het
# dus zichtbaar in `docker ps`. Kies hier een nieuwe waarde.
REDIS_PASSWORD=

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
# Moet `localhost` bevatten, anders geeft de healthcheck van de backend een
# 400 en blijft de container als "unhealthy" staan terwijl hij prima werkt.
ALLOWED_HOSTS=
BASE_URL=
FRONTEND_URL=
FIELD_ENCRYPTION_KEY=

# ── https-gedrag ────────────────────────────────────────────────────────────
# Caddy termineert TLS en zet X-Forwarded-Proto goed, dus deze mogen aan.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=

# ── E-mail ──────────────────────────────────────────────────────────────────
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Betalingen ──────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Let op: de webhook-URL bij Stripe wijst nu naar de Studio. Die moet na de
# verhuizing naar het nieuwe domein, anders komen betalingsmeldingen niet aan.
STRIPE_WEBHOOK_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Foutrapportage ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Deze wordt in de frontend-build gebakken, niet op de server gelezen. Hij moet
# als CI-variabele in GitLab staan, zie deploy/hetzner/README.md.
VITE_SENTRY_DSN=
